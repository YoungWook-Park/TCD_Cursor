<UserControl x:Class="Tcd.App.View.Teach_AxisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Tcd.App"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1600"
             d:DataContext="{d:DesignInstance Type=local:Teach_AxisViewModel}">
  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 상단 툴바 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,2,2,6">
      <Button Content="Save" Width="80" Margin="0,0,6,0"
              Style="{StaticResource PrimaryButtonStyle}"
              Command="{Binding Cmd_Save}"/>
      <Button Content="Revert" Width="80" Margin="0,0,20,0"
              Style="{StaticResource PrimaryButtonStyle}"
              Command="{Binding Cmd_Revert}"/>
      <TextBlock Text="{Binding LogStatus}"
                 VerticalAlignment="Center"
                 FontFamily="Consolas" FontSize="11"
                 Foreground="{StaticResource TextSubtleBrush}"
                 TextWrapping="NoWrap"/>
    </StackPanel>

    <!-- 2분할 메인 영역 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="460"/>
      </Grid.ColumnDefinitions>

      <!-- ══ 좌측: 티칭 DataGrid (상단) + 수동 조작 (하단) ═══════════ -->
      <DockPanel Grid.Column="0">

        <!-- 좌측 하단: 수동 조작 패널 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">

          <!-- INC Move -->
          <GroupBox Header="INC Move" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Margin="8,6">
              <TextBlock Text="Delta :"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBox Width="90" Margin="0,0,12,0"
                       Text="{Binding IncDelta,
                              UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="Speed :"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBox Width="70" Margin="0,0,16,0"
                       Text="{Binding IncSpeed,
                              UpdateSourceTrigger=PropertyChanged}"/>
              <Button Content="Execute" Width="80"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding Cmd_IncMove}"/>
              <Button Content="Stop" Width="70" Margin="8,0,0,0"
                      Style="{StaticResource DangerButtonStyle}"
                      Command="{Binding Cmd_Stop}"/>
            </StackPanel>
          </GroupBox>

          <!-- Jog -->
          <GroupBox Header="Jog">
            <StackPanel Orientation="Horizontal" Margin="8,6">
              <TextBlock Text="Speed :"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBox Width="70" Margin="0,0,12,0"
                       Text="{Binding JogSpeed,
                              UpdateSourceTrigger=PropertyChanged}"/>
              <CheckBox Content="Inching"
                        VerticalAlignment="Center" Margin="0,0,14,0"
                        IsChecked="{Binding IsInching}"/>
              <Button Content="+Jog" Width="72" Margin="0,0,6,0"
                      Style="{StaticResource PrimaryButtonStyle}">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                    <i:InvokeCommandAction
                      Command="{Binding Cmd_JogPlusDown}"/>
                  </i:EventTrigger>
                  <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                    <i:InvokeCommandAction
                      Command="{Binding Cmd_JogPlusUp}"/>
                  </i:EventTrigger>
                  <i:EventTrigger EventName="MouseLeave">
                    <i:InvokeCommandAction
                      Command="{Binding Cmd_JogPlusUp}"/>
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </Button>
              <Button Content="-Jog" Width="72"
                      Style="{StaticResource PrimaryButtonStyle}">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                    <i:InvokeCommandAction
                      Command="{Binding Cmd_JogMinusDown}"/>
                  </i:EventTrigger>
                  <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                    <i:InvokeCommandAction
                      Command="{Binding Cmd_JogMinusUp}"/>
                  </i:EventTrigger>
                  <i:EventTrigger EventName="MouseLeave">
                    <i:InvokeCommandAction
                      Command="{Binding Cmd_JogMinusUp}"/>
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </Button>
            </StackPanel>
          </GroupBox>

        </StackPanel>

        <!-- 좌측 상단: 티칭 포지션 DataGrid -->
        <GroupBox Header="Teach Positions" DockPanel.Dock="Top">
          <DataGrid ItemsSource="{Binding Points}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    RowHeight="28"
                    Margin="4">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Position Name"
                                  Binding="{Binding Name}"
                                  Width="180" IsReadOnly="True"/>
              <DataGridTextColumn Header="Target (mm)"
                                  Binding="{Binding Position,
                                            StringFormat=N3}"
                                  Width="110"/>
              <DataGridTextColumn Header="Speed"
                                  Binding="{Binding Speed,
                                            StringFormat=N1}"
                                  Width="80"/>
              <DataGridTextColumn Header="Accel"
                                  Binding="{Binding Accel,
                                            StringFormat=N1}"
                                  Width="80"/>
              <DataGridTextColumn Header="Decel"
                                  Binding="{Binding Decel,
                                            StringFormat=N1}"
                                  Width="80"/>
              <DataGridTemplateColumn Header="Move" Width="76">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Move" Margin="2,1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding DataContext.Cmd_MoveToPoint,
                              RelativeSource={RelativeSource
                                AncestorType=DataGrid}}"
                            CommandParameter="{Binding}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Teach" Width="76">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Teach" Margin="2,1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding DataContext.Cmd_TeachCurrentPos,
                              RelativeSource={RelativeSource
                                AncestorType=DataGrid}}"
                            CommandParameter="{Binding}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </GroupBox>

      </DockPanel>

      <!-- ══ 우측: Motor Status (상단) / 공란 (하단) ════════════════ -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- 우측 상단: Motor Status -->
        <GroupBox Grid.Row="0" Header="Motor Status">
          <DataGrid ItemsSource="{Binding AxisStatuses}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    RowHeight="26"
                    Margin="4">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Axis"
                                  Binding="{Binding AxisName}"
                                  Width="65"/>
              <DataGridTextColumn Header="Position"
                                  Binding="{Binding Position,
                                            StringFormat=N3}"
                                  Width="90"/>

              <!-- Servo -->
              <DataGridTemplateColumn Header="Servo" Width="55">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell"
                         BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsServoOn}" Value="True">
                        <Setter Property="Background"
                                Value="{StaticResource CellGreenBgBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="OFF"/>
                          <Setter Property="Foreground"
                                  Value="{StaticResource CellOffFgBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsServoOn}"
                                         Value="True">
                              <Setter Property="Text" Value="ON"/>
                              <Setter Property="Foreground"
                                      Value="{StaticResource CellGreenFgBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Home -->
              <DataGridTemplateColumn Header="Home" Width="55">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell"
                         BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsHome}" Value="True">
                        <Setter Property="Background"
                                Value="{StaticResource CellGreenBgBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="—"/>
                          <Setter Property="Foreground"
                                  Value="{StaticResource CellOffFgBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHome}"
                                         Value="True">
                              <Setter Property="Text" Value="HOME"/>
                              <Setter Property="Foreground"
                                      Value="{StaticResource CellGreenFgBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Moving -->
              <DataGridTemplateColumn Header="Moving" Width="60">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell"
                         BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMoving}" Value="True">
                        <Setter Property="Background"
                                Value="{StaticResource CellOrangeBgBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="—"/>
                          <Setter Property="Foreground"
                                  Value="{StaticResource CellOffFgBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMoving}"
                                         Value="True">
                              <Setter Property="Text" Value="MOVING"/>
                              <Setter Property="Foreground"
                                      Value="{StaticResource CellOrangeFgBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Fault -->
              <DataGridTemplateColumn Header="Fault" Width="55">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell"
                         BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFault}" Value="True">
                        <Setter Property="Background"
                                Value="{StaticResource CellRedBgBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="—"/>
                          <Setter Property="Foreground"
                                  Value="{StaticResource CellOffFgBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFault}"
                                         Value="True">
                              <Setter Property="Text" Value="FAULT"/>
                              <Setter Property="Foreground"
                                      Value="{StaticResource CellRedFgBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- +Limit -->
              <DataGridTemplateColumn Header="+Lmt" Width="50">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell"
                         BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLimitPos}" Value="True">
                        <Setter Property="Background"
                                Value="{StaticResource CellRedBgBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="—"/>
                          <Setter Property="Foreground"
                                  Value="{StaticResource CellOffFgBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLimitPos}"
                                         Value="True">
                              <Setter Property="Text" Value="+LMT"/>
                              <Setter Property="Foreground"
                                      Value="{StaticResource CellRedFgBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- -Limit -->
              <DataGridTemplateColumn Header="-Lmt" Width="50">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell"
                         BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLimitNeg}" Value="True">
                        <Setter Property="Background"
                                Value="{StaticResource CellRedBgBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="—"/>
                          <Setter Property="Foreground"
                                  Value="{StaticResource CellOffFgBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLimitNeg}"
                                         Value="True">
                              <Setter Property="Text" Value="-LMT"/>
                              <Setter Property="Foreground"
                                      Value="{StaticResource CellRedFgBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

            </DataGrid.Columns>
          </DataGrid>
        </GroupBox>

        <!-- 우측 하단: 공란 (추후 기능 추가 예정) -->
        <Border Grid.Row="1"
                Margin="0,8,0,0"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
        </Border>

      </Grid>
    </Grid>
  </Grid>
</UserControl>
