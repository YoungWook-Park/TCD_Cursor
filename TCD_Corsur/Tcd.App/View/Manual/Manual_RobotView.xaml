<UserControl x:Class="Tcd.App.View.Manual_RobotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tcd.App"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=local:Manual_RobotViewModel}">
  <UserControl.Resources>
    <!-- IO Signal LED -->
    <Style x:Key="IoLedStyle" TargetType="Ellipse">
      <Setter Property="Width"  Value="12"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Fill"   Value="#444"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="IoLedOnStyle" BasedOn="{StaticResource IoLedStyle}"
           TargetType="Ellipse">
      <Setter Property="Fill" Value="#44DD66"/>
    </Style>
    <Style x:Key="IoLedYellowStyle" BasedOn="{StaticResource IoLedStyle}"
           TargetType="Ellipse">
      <Setter Property="Fill" Value="#FFDD44"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" MaxWidth="700">

      <!-- ══ Connection ══════════════════════════════════════════════════ -->
      <GroupBox Header="Connection" Margin="0,0,0,8">
        <Grid Margin="8,6,8,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="55"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBox   Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="4,2"/>
          <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="8,0,4,0"/>
          <TextBox   Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="4,2"/>
          <Button Grid.Column="4" Content="Connect"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Width="80" Margin="8,0,4,0"
                  Command="{Binding Cmd_Connect}"/>
          <Button Grid.Column="5" Content="Disconnect"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Width="85"
                  Command="{Binding Cmd_Disconnect}"/>

          <!-- 연결 LED -->
          <StackPanel Grid.Column="7" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="12,0,0,0">
            <Ellipse Margin="0,0,5,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse" BasedOn="{StaticResource IoLedStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                      <Setter Property="Fill" Value="#44DD66"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding IsConnected, Converter={x:Null}}"
                       VerticalAlignment="Center" FontSize="11">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="Disconnected"/>
                  <Setter Property="Foreground" Value="#888"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                      <Setter Property="Text" Value="Connected"/>
                      <Setter Property="Foreground" Value="#44DD66"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </GroupBox>

      <!-- ══ IO Signal Status ════════════════════════════════════════════ -->
      <GroupBox Header="IO Signals" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Margin="10,8,10,8">

          <!-- Start IO -->
          <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
            <Ellipse Margin="0,0,5,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse" BasedOn="{StaticResource IoLedStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IoStartOn}" Value="True">
                      <Setter Property="Fill" Value="#44DD66"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="Start IO" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSubtleBrush}"/>
          </StackPanel>

          <!-- Running -->
          <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
            <Ellipse Margin="0,0,5,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse" BasedOn="{StaticResource IoLedStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IoRunning}" Value="True">
                      <Setter Property="Fill" Value="#44DD66"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="Running" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSubtleBrush}"/>
          </StackPanel>

          <!-- Moving -->
          <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
            <Ellipse Margin="0,0,5,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse" BasedOn="{StaticResource IoLedStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IoMoving}" Value="True">
                      <Setter Property="Fill" Value="#FFDD44"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="Moving" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSubtleBrush}"/>
          </StackPanel>

          <!-- Go Ack -->
          <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
            <Ellipse Margin="0,0,5,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse" BasedOn="{StaticResource IoLedStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IoGoAck}" Value="True">
                      <Setter Property="Fill" Value="#44AAFF"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="Go_Ack" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSubtleBrush}"/>
          </StackPanel>

          <!-- Complete -->
          <StackPanel Orientation="Horizontal">
            <Ellipse Margin="0,0,5,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse" BasedOn="{StaticResource IoLedStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IoComplete}" Value="True">
                      <Setter Property="Fill" Value="#44DD66"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="Complete" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSubtleBrush}"/>
          </StackPanel>

        </StackPanel>
      </GroupBox>

      <!-- ══ Initialize ══════════════════════════════════════════════════ -->
      <GroupBox Header="Initialize" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Margin="10,8,10,8">
          <Button Content="Init  (Start IO On)"
                  Width="160" Height="32"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding Cmd_InitStartIo}"/>
          <TextBlock Text="  →  Running IO On 후 동작 준비 완료"
                     VerticalAlignment="Center" FontSize="11"
                     Foreground="{StaticResource TextSubtleBrush}"/>
        </StackPanel>
      </GroupBox>

      <!-- ══ Motion Control ══════════════════════════════════════════════ -->
      <GroupBox Header="Motion Control" Margin="0,0,0,8">
        <Grid Margin="10,8,10,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Velocity -->
          <TextBlock Grid.Row="0" Grid.Column="0"
                     Text="Velocity:" VerticalAlignment="Center"
                     FontSize="12" Margin="0,0,8,6"/>
          <Slider    Grid.Row="0" Grid.Column="1"
                     Minimum="1" Maximum="100"
                     Value="{Binding Velocity}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,6"/>
          <TextBlock Grid.Row="0" Grid.Column="2"
                     VerticalAlignment="Center" Margin="0,0,0,6"
                     FontFamily="Consolas" FontSize="12">
            <Run Text="{Binding Velocity, Mode=OneWay}"/>
            <Run Text="%"/>
          </TextBlock>

          <!-- Program -->
          <TextBlock Grid.Row="1" Grid.Column="0"
                     Text="Program:" VerticalAlignment="Center"
                     FontSize="12" Margin="0,0,8,6"/>
          <ComboBox  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                     ItemsSource="{Binding Programs}"
                     SelectedItem="{Binding SelectedProgramItem}"
                     DisplayMemberPath="Label"
                     Margin="0,0,0,6"/>

          <!-- Buttons -->
          <StackPanel Grid.Row="2" Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Orientation="Horizontal"
                      Margin="0,4,0,0">
            <Button Content="Go"
                    Width="80" Height="34"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding Cmd_Go}"
                    Margin="0,0,8,0"/>
            <Button Content="STOP"
                    Width="80" Height="34"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding Cmd_Stop}"
                    Margin="0,0,8,0"/>
            <Button Content="Reset"
                    Width="80" Height="34"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding Cmd_Reset}"/>
          </StackPanel>
        </Grid>
      </GroupBox>

      <!-- ══ Status Log ══════════════════════════════════════════════════ -->
      <GroupBox Header="Status">
        <Grid Margin="8,4,8,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="{Binding LogStatus}"
                     FontFamily="Consolas" FontSize="12"
                     TextWrapping="Wrap" Margin="0,0,0,6"/>

          <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Position: " FontSize="11"
                       Foreground="{StaticResource TextSubtleBrush}"/>
            <TextBlock Text="{Binding CurrentPosition}" FontSize="11"
                       FontFamily="Consolas"/>
            <TextBlock Text="  Error: " FontSize="11"
                       Foreground="{StaticResource TextSubtleBrush}"
                       Margin="12,0,0,0"/>
            <TextBlock FontSize="11" FontFamily="Consolas">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="—"/>
                  <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsError}" Value="True">
                      <Setter Property="Text" Value="FAULT"/>
                      <Setter Property="Foreground" Value="{StaticResource CellRedFgBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </GroupBox>

    </StackPanel>
  </ScrollViewer>
</UserControl>
