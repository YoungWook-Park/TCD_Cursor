<UserControl x:Class="Tcd.App.View.Manual_MotorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Tcd.App"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1600"
             d:DataContext="{d:DesignInstance Type=local:Manual_MotorViewModel}">
  <Grid Margin="6">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ══ 좌: Motor Status + STOP ALL ══════════════════════════════════ -->
    <DockPanel Grid.Column="0" LastChildFill="False">

      <GroupBox DockPanel.Dock="Top" Header="Motor Status">
        <DataGrid ItemsSource="{Binding AxisStatuses}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="26"
                  Margin="4">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Axis"    Binding="{Binding AxisName}" Width="60"/>
            <DataGridTextColumn Header="Position" Binding="{Binding Position, StringFormat=N3}" Width="85"/>

            <DataGridTemplateColumn Header="Servo" Width="55">
              <DataGridTemplateColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsServoOn}" Value="True">
                      <Setter Property="Background" Value="{StaticResource CellGreenBgBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTemplateColumn.CellStyle>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="OFF"/>
                        <Setter Property="Foreground" Value="{StaticResource CellOffFgBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsServoOn}" Value="True">
                            <Setter Property="Text" Value="ON"/>
                            <Setter Property="Foreground" Value="{StaticResource CellGreenFgBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Home" Width="55">
              <DataGridTemplateColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHome}" Value="True">
                      <Setter Property="Background" Value="{StaticResource CellGreenBgBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTemplateColumn.CellStyle>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="—"/>
                        <Setter Property="Foreground" Value="{StaticResource CellOffFgBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsHome}" Value="True">
                            <Setter Property="Text" Value="HOME"/>
                            <Setter Property="Foreground" Value="{StaticResource CellGreenFgBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Moving" Width="60">
              <DataGridTemplateColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMoving}" Value="True">
                      <Setter Property="Background" Value="{StaticResource CellOrangeBgBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTemplateColumn.CellStyle>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="—"/>
                        <Setter Property="Foreground" Value="{StaticResource CellOffFgBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMoving}" Value="True">
                            <Setter Property="Text" Value="MOVING"/>
                            <Setter Property="Foreground" Value="{StaticResource CellOrangeFgBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Fault" Width="55">
              <DataGridTemplateColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFault}" Value="True">
                      <Setter Property="Background" Value="{StaticResource CellRedBgBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTemplateColumn.CellStyle>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="—"/>
                        <Setter Property="Foreground" Value="{StaticResource CellOffFgBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsFault}" Value="True">
                            <Setter Property="Text" Value="FAULT"/>
                            <Setter Property="Foreground" Value="{StaticResource CellRedFgBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="+Lmt" Width="50">
              <DataGridTemplateColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLimitPos}" Value="True">
                      <Setter Property="Background" Value="{StaticResource CellRedBgBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTemplateColumn.CellStyle>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="—"/>
                        <Setter Property="Foreground" Value="{StaticResource CellOffFgBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLimitPos}" Value="True">
                            <Setter Property="Text" Value="+LMT"/>
                            <Setter Property="Foreground" Value="{StaticResource CellRedFgBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="-Lmt" Width="50">
              <DataGridTemplateColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLimitNeg}" Value="True">
                      <Setter Property="Background" Value="{StaticResource CellRedBgBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTemplateColumn.CellStyle>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="—"/>
                        <Setter Property="Foreground" Value="{StaticResource CellOffFgBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLimitNeg}" Value="True">
                            <Setter Property="Text" Value="-LMT"/>
                            <Setter Property="Foreground" Value="{StaticResource CellRedFgBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

          </DataGrid.Columns>
        </DataGrid>
      </GroupBox>

      <!-- STOP ALL 버튼 -->
      <Button DockPanel.Dock="Top" Content="STOP ALL"
              Height="36" Margin="4,8,4,0"
              Style="{StaticResource DangerButtonStyle}"
              Command="{Binding Cmd_StopAllMotors}"/>

      <!-- 상태 로그 -->
      <TextBlock DockPanel.Dock="Top"
                 Text="{Binding LogStatus}"
                 FontFamily="Consolas" FontSize="11"
                 Foreground="{StaticResource TextSubtleBrush}"
                 TextWrapping="Wrap"
                 Margin="4,6,4,0"
                 MaxWidth="430"/>
    </DockPanel>

    <!-- ══ 우: TabControl (Teach / Manual) ════════════════════════════════ -->
    <TabControl Grid.Column="2">

      <!-- ── Teach 탭 ──────────────────────────────────────────────────── -->
      <TabItem Header="Teach" Height="28">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- 툴바 -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,4">
            <Button Content="Save" Width="70" Margin="0,0,6,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding Cmd_SaveTeach}"/>
            <Button Content="Load" Width="70"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding Cmd_LoadTeach}"/>
          </StackPanel>

          <!-- 축별 티칭 그룹 -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AxisTeachGroups}" Margin="4,0,4,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:Manual_MotorViewModel+AxisTeachGroup}">
                  <GroupBox Margin="0,0,0,8">
                    <GroupBox.Header>
                      <TextBlock Text="{Binding DisplayName}"
                                 FontWeight="SemiBold" FontSize="12"/>
                    </GroupBox.Header>

                    <ItemsControl ItemsSource="{Binding Points}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Manual_MotorViewModel+AxisTeachPoint}">
                          <!-- 각 티칭 포인트 행 -->
                          <Grid Margin="2,2,2,2">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180"/>
                              <ColumnDefinition Width="90"/>
                              <ColumnDefinition Width="70"/>
                              <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBox Grid.Column="1"
                                     Margin="4,0"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Consolas" FontSize="12"
                                     Text="{Binding Position, StringFormat=N3,
                                            UpdateSourceTrigger=LostFocus}"/>

                            <Button Grid.Column="2"
                                    Content="Move"
                                    Margin="0,1,4,1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding DataContext.Cmd_MoveToTeachPoint,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl,
                                              AncestorLevel=2}}">
                              <Button.CommandParameter>
                                <MultiBinding>
                                  <MultiBinding.Converter>
                                    <local:AxisTeachPointParamConverter/>
                                  </MultiBinding.Converter>
                                  <Binding Path="DataContext.AxisName"
                                           RelativeSource="{RelativeSource AncestorType=ItemsControl,
                                           AncestorLevel=1}"/>
                                  <Binding Path="."/>
                                </MultiBinding>
                              </Button.CommandParameter>
                            </Button>

                            <Button Grid.Column="3"
                                    Content="Teach"
                                    Margin="0,1,0,1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding DataContext.Cmd_TeachCurrentPos,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl,
                                              AncestorLevel=2}}">
                              <Button.CommandParameter>
                                <MultiBinding>
                                  <MultiBinding.Converter>
                                    <local:AxisTeachPointParamConverter/>
                                  </MultiBinding.Converter>
                                  <Binding Path="DataContext.AxisName"
                                           RelativeSource="{RelativeSource AncestorType=ItemsControl,
                                           AncestorLevel=1}"/>
                                  <Binding Path="."/>
                                </MultiBinding>
                              </Button.CommandParameter>
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </GroupBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ── Manual 탭 ─────────────────────────────────────────────────── -->
      <TabItem Header="Manual" Height="28">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8,6,8,6">

            <!-- 축별 Move/Stop/Servo/Home 행 -->
            <GroupBox Header="Axis Control" Margin="0,0,0,8">
              <Grid Margin="6">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="65"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="68"/>
                  <ColumnDefinition Width="68"/>
                  <ColumnDefinition Width="68"/>
                  <ColumnDefinition Width="68"/>
                  <ColumnDefinition Width="68"/>
                </Grid.ColumnDefinitions>

                <!-- Header row -->
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Target" FontSize="11"
                           Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Move" FontSize="11"
                           Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Stop" FontSize="11"
                           Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Srv ON" FontSize="11"
                           Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Text="Srv OFF" FontSize="11"
                           Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Home" FontSize="11"
                           Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                <!-- U -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="U" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,6,4" Text="{Binding U, UpdateSourceTrigger=PropertyChanged}"/>
                <Button    Grid.Row="1" Grid.Column="2" Margin="2,0,2,4" Content="Move" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_MoveU}"/>
                <Button    Grid.Row="1" Grid.Column="3" Margin="2,0,2,4" Content="Stop" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_StopU}"/>
                <Button    Grid.Row="1" Grid.Column="4" Margin="2,0,2,4" Content="ON"   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_ServoOnU}"/>
                <Button    Grid.Row="1" Grid.Column="5" Margin="2,0,2,4" Content="OFF"  Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_ServoOffU}"/>
                <Button    Grid.Row="1" Grid.Column="6" Margin="2,0,0,4" Content="Home" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_HomeU}"/>

                <!-- V -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="V" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,6,4" Text="{Binding V, UpdateSourceTrigger=PropertyChanged}"/>
                <Button    Grid.Row="2" Grid.Column="2" Margin="2,0,2,4" Content="Move" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_MoveV}"/>
                <Button    Grid.Row="2" Grid.Column="3" Margin="2,0,2,4" Content="Stop" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_StopV}"/>
                <Button    Grid.Row="2" Grid.Column="4" Margin="2,0,2,4" Content="ON"   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_ServoOnV}"/>
                <Button    Grid.Row="2" Grid.Column="5" Margin="2,0,2,4" Content="OFF"  Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_ServoOffV}"/>
                <Button    Grid.Row="2" Grid.Column="6" Margin="2,0,0,4" Content="Home" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_HomeV}"/>

                <!-- W -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="W" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,6,4" Text="{Binding W, UpdateSourceTrigger=PropertyChanged}"/>
                <Button    Grid.Row="3" Grid.Column="2" Margin="2,0,2,4" Content="Move" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_MoveW}"/>
                <Button    Grid.Row="3" Grid.Column="3" Margin="2,0,2,4" Content="Stop" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_StopW}"/>
                <Button    Grid.Row="3" Grid.Column="4" Margin="2,0,2,4" Content="ON"   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_ServoOnW}"/>
                <Button    Grid.Row="3" Grid.Column="5" Margin="2,0,2,4" Content="OFF"  Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_ServoOffW}"/>
                <Button    Grid.Row="3" Grid.Column="6" Margin="2,0,0,4" Content="Home" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_HomeW}"/>

                <!-- ZLower -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="ZLower" VerticalAlignment="Center" Margin="0,0,6,4" FontSize="11"/>
                <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,0,6,4" Text="{Binding ZLoad, UpdateSourceTrigger=PropertyChanged}"/>
                <Button    Grid.Row="4" Grid.Column="2" Margin="2,0,2,4" Content="Move" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_MoveZLoad}"/>
                <Button    Grid.Row="4" Grid.Column="3" Margin="2,0,2,4" Content="Stop" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_StopZLoad}"/>
                <Button    Grid.Row="4" Grid.Column="4" Margin="2,0,2,4" Content="ON"   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_ServoOnZLoad}"/>
                <Button    Grid.Row="4" Grid.Column="5" Margin="2,0,2,4" Content="OFF"  Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_ServoOffZLoad}"/>
                <Button    Grid.Row="4" Grid.Column="6" Margin="2,0,0,4" Content="Home" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_HomeZLoad}"/>
              </Grid>
            </GroupBox>

            <!-- ZUpper 별도 행 (ZLower 와 구조적으로 분리) -->
            <GroupBox Header="ZUpper" Margin="0,0,0,8">
              <Grid Margin="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="65"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="68"/>
                  <ColumnDefinition Width="68"/>
                  <ColumnDefinition Width="68"/>
                  <ColumnDefinition Width="68"/>
                  <ColumnDefinition Width="68"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ZUpper" VerticalAlignment="Center" FontSize="11"/>
                <TextBox   Grid.Column="1" Margin="0,0,6,0" Text="{Binding ZBond, UpdateSourceTrigger=PropertyChanged}"/>
                <Button    Grid.Column="2" Margin="2,0,2,0" Content="Move" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_MoveZBond}"/>
                <Button    Grid.Column="3" Margin="2,0,2,0" Content="Stop" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_StopZBond}"/>
                <Button    Grid.Column="4" Margin="2,0,2,0" Content="ON"   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_ServoOnZBond}"/>
                <Button    Grid.Column="5" Margin="2,0,2,0" Content="OFF"  Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_ServoOffZBond}"/>
                <Button    Grid.Column="6" Margin="2,0,0,0" Content="Home" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Cmd_HomeZBond}"/>
              </Grid>
            </GroupBox>

            <!-- Jog -->
            <GroupBox Header="Jog">
              <StackPanel Orientation="Horizontal" Margin="6,4,6,4">
                <TextBlock Text="Axis:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                <ComboBox Width="80" ItemsSource="{Binding Axes}"
                          SelectedItem="{Binding SelectedAxis}"/>
                <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="10,0,6,0" FontSize="11"/>
                <TextBox Width="60" Text="{Binding JogSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="+Jog" Width="60" Margin="10,0,4,0"
                        Style="{StaticResource PrimaryButtonStyle}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                      <i:InvokeCommandAction Command="{Binding Cmd_JogPlusDown}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                      <i:InvokeCommandAction Command="{Binding Cmd_JogPlusUp}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                      <i:InvokeCommandAction Command="{Binding Cmd_JogPlusUp}"/>
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Button>
                <Button Content="-Jog" Width="60"
                        Style="{StaticResource PrimaryButtonStyle}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                      <i:InvokeCommandAction Command="{Binding Cmd_JogMinusDown}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                      <i:InvokeCommandAction Command="{Binding Cmd_JogMinusUp}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                      <i:InvokeCommandAction Command="{Binding Cmd_JogMinusUp}"/>
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Button>
              </StackPanel>
            </GroupBox>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
